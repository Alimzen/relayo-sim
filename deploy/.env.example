# Copy to deploy/.env and fill in. Never commit the real file.

# Public name of the simulator. Point its DNS A (and AAAA, if the server has IPv6) record at the server first.
SIM_DOMAIN=relayo.example.com

# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
# For /v1/admin/projects (scripts). Leave empty to disable those endpoints.
ADMIN_TOKEN=
# Who reviews requests for Relayo's own sending in the panel (Administración). Comma separated; the
# accounts must have confirmed their email.
ADMIN_EMAILS=

# "closed" stops new sign-ups (private beta: create accounts by invitation only).
SIGNUP=open

# Free plan, per project. 0 = no limit.
MONTHLY_MESSAGE_LIMIT=1000
MESSAGES_PER_MINUTE=120
# Real (live) messages per project and month, counted apart from simulated ones.
LIVE_MONTHLY_MESSAGE_LIMIT=1000
# Days messages (and their captured content) are kept. 0 = forever.
RETENTION_DAYS=7

# The simulator's own email (password resets): any SMTP server or provider that gives SMTP credentials
# (Amazon SES, Resend, Postmark, Mailgun, Brevo...). The sender's domain must be verified there.
# Without MAIL_URL, reset links only go to the log (docker compose logs sim).
MAIL_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Relayo Sim <no-reply@example.com>

# Optional: links to your terms and privacy policy in the sign-up form. Without them, the form shows none.
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy

# Live mode: key that encrypts the provider credentials of each project's connections (email and Twilio SMS).
# Generate it once (openssl rand -base64 32) and keep it: changing it makes stored credentials unreadable.
SECRETS_KEY=
# To change SECRETS_KEY: put the old key here and the new one above, restart, and remove this line once the
# log says every secret uses the new key.
# SECRETS_KEY_PREVIOUS=

# Optional: Relayo's own sending, through a relay of yours (Amazon SES SMTP, for example). Without it, the option
# does not show. Events of the relay: point an SNS subscription at https://<host>/v1/inbound/managed/<token>.
# MANAGED_SMTP_URL=smtp://user:password@email-smtp.us-east-1.amazonaws.com:587
# MANAGED_SPF_INCLUDE=amazonses.com
# MANAGED_DAILY_LIMIT=200
# MANAGED_EVENTS_TOKEN=
# With Amazon SES as the relay: each domain is registered in SES with the same DKIM key, so SES accepts it.
# The keys need ses:CreateEmailIdentity and ses:GetEmailIdentity.
# MANAGED_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# "auto" lets every project use it without a review by an admin.
# MANAGED_APPROVAL=manual
