{
  "name": "relayo-sim",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "description": "Relayo Sim: a delivery scenario simulator for email. Send to it and it answers like the real world.",
  "type": "module",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file=.env scripts/smoke.ts"
  },
  "dependencies": {
    "@alimzen/relayo": "^0.4.0",
    "@alimzen/relayo-mailgun": "^0.1.0",
    "@alimzen/relayo-postmark": "^0.1.0",
    "@alimzen/relayo-resend": "^0.1.0",
    "@alimzen/relayo-sendgrid": "^0.1.0",
    "@alimzen/relayo-ses": "^0.1.0",
    "@alimzen/relayo-smtp": "^0.2.1",
    "@alimzen/relayo-twilio": "^0.1.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "bullmq": "^6.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mailparser": "^3.12.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "smtp-server": "^3.21.1"
  },
  "devDependencies": {
    "@alimzen/relayo-bounces": "^0.1.0",
    "@alimzen/relayo-simulator": "^0.2.0",
    "@nestjs/testing": "^12",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0",
    "vitest": "^5.0"
  }
}
